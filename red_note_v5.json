        "id": "prep01",
        "type": "BlockBasic",
        "initialized": false,
        "position": { "x": 900, "y": 0 },
        "data": {
          "description": "准备关键词",
          "disableBlock": false,
          "timeout": 20000,
          "context": "website",
          "code": "const DEFAULT_KEYWORDS = '阿德莱德修车';\nconst DEFAULT_PER_KEYWORD = 30;\ntry {\n  const kwRaw = String(automaRefData('variables', '关键词') || DEFAULT_KEYWORDS);\n  let per = parseInt(automaRefData('variables', '每个关键词篇数'), 10);\n  if (!per || per < 1) per = DEFAULT_PER_KEYWORD;\n  const kwList = kwRaw.split(/[,，、;；]+/).map(s => s.trim()).filter(Boolean).map(kw => ({ kw: kw, url: 'https://www.xiaohongshu.com/search_result?keyword=' + encodeURIComponent(kw) + '&source=web_explore_feed' }));\n  automaSetVariable('kwList', kwList);\n  automaSetVariable('perKeyword', per);\n  automaSetVariable('allLinks', []);\n  console.log('[准备] 关键词：' + kwList.map(k => k.kw).join(' / ') + '，每个关键词 ' + per + ' 篇');\n} catch (e) {\n  console.error('[准备] 出错', e);\n}\nautomaNextBlock();",
