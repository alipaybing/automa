      {
        "id": "collect01",
        "type": "BlockBasic",
        "initialized": false,
        "position": { "x": 1200, "y": 250 },
        "data": {
          "description": "滚动收集链接",
          "disableBlock": false,
          "timeout": 300000,
          "context": "website",
          "code": "(async () => {\n  const sleep = ms => new Promise(r => setTimeout(r, ms));\n  try {\n    const per = Number(automaRefData('variables', 'perKeyword')) || 30;\n    const all = automaRefData('variables', 'allLinks') || [];\n    let kw = '';\n    try { kw = new URL(location.href).searchParams.get('keyword') || ''; } catch (e) {}\n    if (!kw) { const inp = document.querySelector('#search-input, textarea#search-input-in-feeds'); if (inp) kw = inp.value || ''; }\n    const seen = new Set(all.map(x => x.id));\n    const got = [];\n    let idle = 0;\n    for (let round = 0; round < 60 && got.length < per && idle < 6; round++) {\n      const before = got.length;\n      const cards = document.querySelectorAll('div.feeds-container section a.cover, section.note-item a.cover');\n      cards.forEach(a => {\n        if (got.length >= per) return;\n        const href = a.href || '';\n        const m = href.match(/([0-9a-f]{24})/i);\n        if (!m) return;\n        const id = m[1].toLowerCase();\n        if (seen.has(id)) return;\n        seen.add(id);\n        got.push({ id: id, kw: kw, url: href });\n      });\n      idle = got.length === before ? idle + 1 : 0;\n      if (got.length >= per) break;\n      const last = cards[cards.length - 1];\n      if (last) last.scrollIntoView({ block: 'end' });\n      window.scrollBy(0, 1200);\n      await sleep(1500 + Math.floor(Math.random() * 1000));\n    }\n    automaSetVariable('allLinks', all.concat(got));\n    console.log('[收集] ' + kw + '：本词 ' + got.length + ' 篇，累计 ' + (all.length + got.length) + ' 篇');\n  } catch (e) {\n    console.error('[收集] 出错', e);\n  }\n  automaNextBlock();\n})();",
          "preloadScripts": [],
          "everyNewTab": false,
          "runBeforeLoad": false
        },
        "label": "javascript-code"
